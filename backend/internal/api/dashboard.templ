package api

// Server-rendered command center powered by Templ + HTMX (SSE fan-out).
// The React SPA and this dashboard observe the exact same event stream.

type dashRow struct {
	ID       string
	Status   string
	Severity string
}

templ DashboardPage(rows []dashRow) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<title>auto-sre — HTMX command center</title>
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
			<script src="https://unpkg.com/htmx-ext-sse@2.2.2"></script>
			<style>
				body { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; background: #0b1220; color: #e2e8f0; margin: 0; }
				main { max-width: 900px; margin: 0 auto; padding: 2rem; }
				h1 { font-size: 1.25rem; }
				table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
				th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #1e293b; }
				button { background: #2563eb; color: #fff; border: 0; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; }
				#stream { list-style: none; padding: 0; max-height: 320px; overflow-y: auto; }
				#stream li { padding: 0.4rem 0; border-bottom: 1px dashed #1e293b; font-size: 0.8rem; white-space: pre-wrap; }
				.badge { padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.7rem; }
				.badge.ok { background: #166534; }
				.badge.warn { background: #854d0e; }
				.badge.err { background: #991b1b; }
			</style>
		</head>
		<body hx-ext="sse">
			<main>
				<h1>auto-sre · HTMX dashboard</h1>
				<p style="color:#94a3b8">Server-rendered with <b>Templ</b>, live events over <b>SSE</b>, driven by <b>HTMX</b>.</p>
				<button hx-get="/api/v1/dashboard/incidents" hx-target="#incidents-body" hx-swap="outerHTML">
					Refresh incidents
				</button>
				<table>
					<thead>
						<tr><th>Incident</th><th>Status</th><th>Severity</th></tr>
					</thead>
					<tbody id="incidents-body">
						if len(rows) == 0 {
							<tr><td colspan="3">No incidents yet — POST /api/v1/incidents to create one.</td></tr>
						}
						for _, r := range rows {
							<tr>
								<td>{ r.ID }</td>
								<td>{ r.Status }</td>
								<td><span class="badge { badgeClass(r.Severity) }">{ r.Severity }</span></td>
							</tr>
						}
					</tbody>
				</table>
				<h2>Live event stream (SSE)</h2>
				<ul id="stream" sse-connect="/api/v1/events/stream" sse-swap="message" hx-swap="afterbegin"></ul>
			</main>
		</body>
	</html>
}

templ IncidentsFragment(rows []dashRow) {
	<tbody id="incidents-body" hx-swap="outerHTML">
		if len(rows) == 0 {
			<tr><td colspan="3">No incidents yet — POST /api/v1/incidents to create one.</td></tr>
		}
		for _, r := range rows {
			<tr>
				<td>{ r.ID }</td>
				<td>{ r.Status }</td>
				<td><span class="badge { badgeClass(r.Severity) }">{ r.Severity }</span></td>
			</tr>
		}
	</tbody>
}
