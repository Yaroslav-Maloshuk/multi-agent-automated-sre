// Prisma schema for the Auto-SRE Workspace persistence layer.
// Prisma manages relational state (incidents, runs, patches, approvals,
// tokens, sandboxes); the `agent_memory` table for hybrid retrieval is
// created by the memory store (pgvector + tsvector) via raw SQL.

generator client {
  provider = "prisma-client-py"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id          String            @id @default(cuid())
  title       String
  severity    String            @default("high")
  source      String            @default("api")
  service     String?
  status      String            @default("QUEUED")
  payload     Json
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  runs        GraphRun[]
  approvals   ApprovalDecision[]
  tokenUsage  TokenUsage[]
  patches     Patch[]

  @@map("incidents")
}

model GraphRun {
  id            String          @id @default(cuid())
  incidentId    String          @map("incident_id")
  incident      Incident        @relation(fields: [incidentId], references: [id])
  status        String          @default("QUEUED")
  correlationId String          @map("correlation_id")
  startedAt     DateTime        @default(now()) @map("started_at")
  finishedAt    DateTime?       @map("finished_at")
  error         String?
  steps         GraphStep[]
  patches       Patch[]

  @@index([incidentId])
  @@map("graph_runs")
}

model GraphStep {
  id            String          @id @default(cuid())
  runId         String          @map("run_id")
  run           GraphRun        @relation(fields: [runId], references: [id])
  stepIndex     Int             @map("step_index")
  node          String
  status        String
  summary       String
  snapshotRef   String?         @map("snapshot_ref")
  durationMs    Int             @default(0) @map("duration_ms")
  startedAt     DateTime        @default(now()) @map("started_at")
  finishedAt    DateTime        @default(now()) @map("finished_at")

  @@unique([runId, stepIndex])
  @@map("graph_steps")
}

model Patch {
  id          String            @id @default(cuid())
  patchRef    String            @unique @map("patch_ref")
  incidentId  String            @map("incident_id")
  incident    Incident          @relation(fields: [incidentId], references: [id])
  runId       String            @map("run_id")
  run         GraphRun          @relation(fields: [runId], references: [id])
  status      String            @default("DRAFT")
  summary     String
  diff        String
  files       Json              @default("[]")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([incidentId])
  @@map("patches")
}

model ApprovalDecision {
  id          String            @id @default(cuid())
  incidentId  String            @map("incident_id")
  incident    Incident          @relation(fields: [incidentId], references: [id])
  patchRef    String            @map("patch_ref")
  action      String
  reason      String?
  reviewedBy  String            @default("operator") @map("reviewed_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([incidentId])
  @@map("approval_decisions")
}

model TokenUsage {
  id            String    @id @default(cuid())
  incidentId    String    @map("incident_id")
  incident      Incident  @relation(fields: [incidentId], references: [id])
  runId         String    @map("run_id")
  agent         String
  inputTokens   Int       @default(0) @map("input_tokens")
  outputTokens  Int       @default(0) @map("output_tokens")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([incidentId])
  @@map("token_usage")
}

model SandboxInstance {
  id          String    @id @default(cuid())
  containerId String?   @map("container_id")
  backend     String
  status      String    @default("WARM")
  incidentId  String?   @map("incident_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  reapedAt    DateTime? @map("reaped_at")

  @@map("sandbox_instances")
}
