# ─────────────────────────────────────────────────────────────
# Multi-Agent Automated SRE Workspace — Environment Template
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

APP_NAME=auto-sre-workspace
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
GATEWAY_ADDR=:8000

# ── Infrastructure ────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_EVENTS_PREFIX=sre.events
NATS_RUN_REQUEST=sre.run.request
POSTGRES_URL=postgresql://sre:sre@localhost:5432/sre
VALKEY_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sre_snapshots
QDRANT_MEMORY_COLLECTION=sre_memory

# ── AI Gateway (FastAPI on :8002) ────────────────────────────
AI_QDRANT_URL=http://localhost:6333
AI_QDRANT_COLLECTION=sre_snapshots
AI_LANCEDB_PATH=var/lancedb
AI_SQLITE_PATH=var/vectorless.db
AI_DEFAULT_MODEL=local/Qwen/Qwen2.5-3B-Instruct
# Optional: route gateway LLM calls through the LiteLLM proxy (:4000).
# Empty = direct routing to the provider (Candle/vLLM/Ray/OpenAI/Anthropic).
AI_RAY_URL=http://localhost:8001
AI_PROXY_URL=

# ── Pingora edge proxy (:8080) ───────────────────────────────
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
AI_HOST=127.0.0.1
AI_PORT=8002
CANDLE_HOST=127.0.0.1
CANDLE_PORT=11434

# ── LLM Serving: vLLM (:8001) / Ray Serve (:8265) ───────────
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
VLLM_URL=http://localhost:8001
RAY_DASHBOARD_URL=http://localhost:8265

# ── CORS (comma separated) ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider: openai | anthropic | local (Candle) | ai (AI gateway) ──
# `ai` routes every agent LLM call through the FastAPI AI gateway (:8002),
# which uses LiteLLM to reach the final model + RAG + structured calling.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Python-free local inference via the Candle OpenAI-compatible endpoint
# (note the /v1 suffix — the inference server only serves /v1/* routes).
CANDLE_URL=http://localhost:11434/v1
CANDLE_MODEL=Qwen/Qwen2.5-3B-Instruct
# AI gateway (used when LLM_PROVIDER=ai; also the embeddings fallback).
AI_URL=http://localhost:8002/v1
AI_MODEL=local/Qwen/Qwen2.5-3B-Instruct
MAX_TOKENS_PER_RUN=200000
TOKEN_PRICE_PER_1K_IN=0.005
TOKEN_PRICE_PER_1K_OUT=0.015

# ── Docker Sandbox Pool ──────────────────────────────────────
DOCKER_SANDBOX_IMAGE=auto-sre/sandbox:dev
SANDBOX_POOL_MIN_WARM=3
SANDBOX_POOL_MAX=5
SANDBOX_CPU_QUOTA=1.5
SANDBOX_MEM_LIMIT=512m
SANDBOX_NETWORK_MODE=none
SANDBOX_DEFAULT_WORKDIR=/workspace

# ── Graph Orchestrator ───────────────────────────────────────
GRAPH_MAX_VERIFIER_ATTEMPTS=3
GRAPH_HITL_AUTO_APPROVE=false
GRAPH_HITL_TIMEOUT_SECONDS=0

# ── Observability ────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Alert Collectors (native ingestion) ──────────────────────
# Comma-separated pollers: prometheus,datadog,kubernetes (empty = push only)
COLLECTORS_ENABLED=
COLLECTOR_POLL_INTERVAL=30
PROMETHEUS_URL=
PROMETHEUS_QUERY=ALERTS
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_MONITOR_TAGS=
KUBERNETES_KUBECONFIG=

# ── Business / ROI model ─────────────────────────────────────
HUMAN_MTTR_SECONDS=2100
HUMAN_LOADED_COST_PER_HOUR=150
