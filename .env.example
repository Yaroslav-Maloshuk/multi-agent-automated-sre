# ─────────────────────────────────────────────────────────────
# Multi-Agent Automated SRE Workspace — Environment Template
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

APP_NAME=auto-sre-workspace
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Infrastructure ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://sre:sre@localhost:5432/sre
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CORS (comma separated) ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider: openai | anthropic | local ─────────────────
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# HuggingFace model id (auto-downloaded on first load) or a local dir.
LOCAL_MODEL_PATH=Qwen/Qwen2.5-3B-Instruct
MAX_TOKENS_PER_RUN=200000
TOKEN_PRICE_PER_1K_IN=0.005
TOKEN_PRICE_PER_1K_OUT=0.015

# ── Docker Sandbox Pool ──────────────────────────────────────
DOCKER_SANDBOX_IMAGE=auto-sre/sandbox:dev
SANDBOX_POOL_MIN_WARM=3
SANDBOX_POOL_MAX=5
SANDBOX_CPU_QUOTA=1.5
SANDBOX_MEM_LIMIT=512m
SANDBOX_NETWORK_MODE=none
SANDBOX_DEFAULT_WORKDIR=/workspace

# ── Graph Orchestrator ───────────────────────────────────────
GRAPH_MAX_VERIFIER_ATTEMPTS=3
GRAPH_HITL_AUTO_APPROVE=false
GRAPH_HITL_TIMEOUT_SECONDS=0

# ── Observability ────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
